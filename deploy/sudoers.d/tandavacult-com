# Installed once, by hand, as admin (deploy has no sudo to install its own
# rules): see deploy.sh's header for the exact command. Scoped narrowly to
# this domain only, matching every other app on the host (check
# `sudo -n -l` as deploy to see the rest).
# (File name has no dots: sudo ignores /etc/sudoers.d files whose names contain one.)
deploy ALL=(root) NOPASSWD: /bin/cp /tmp/tandavacult.com.bootstrap.conf /etc/nginx/sites-available/tandavacult.com, /bin/cp /tmp/tandavacult.com.conf /etc/nginx/sites-available/tandavacult.com, /usr/bin/certbot certonly --webroot -w /var/www/certbot -d tandavacult.com -d www.tandavacult.com --non-interactive --agree-tos -m simplex0@gmail.com --deploy-hook systemctl reload nginx
